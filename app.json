{
  "expo": {
    "name": "Margen",
    "slug": "margen-conductores",
    "scheme": "margen",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.margen.piloto"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona una captura para analizar sus datos en tu dispositivo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
